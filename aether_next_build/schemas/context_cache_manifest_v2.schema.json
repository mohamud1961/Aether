{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aether-next.local/schemas/context_cache_manifest_v2.schema.json",
  "title": "Aether-Next Context Cache Manifest v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["stable_prefix_sha256", "stable_prefix_bytes", "request_bytes", "common_prefix_bytes_with_previous", "exact_reusable_share", "stable_share", "config_version", "epoch_id", "event_count", "envmap_version", "envmap_sha256"],
  "properties": {
    "stable_prefix_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "stable_prefix_bytes": {"type": "integer", "minimum": 0},
    "request_bytes": {"type": "integer", "minimum": 0},
    "common_prefix_bytes_with_previous": {"type": "integer", "minimum": 0},
    "exact_reusable_share": {"type": "number", "minimum": 0, "maximum": 1},
    "stable_share": {"type": "number", "minimum": 0, "maximum": 1},
    "config_version": {"type": "integer", "minimum": 1},
    "epoch_id": {"type": "integer", "minimum": 1},
    "event_count": {"type": "integer", "minimum": 0},
    "provider_input_tokens": {"type": ["integer", "null"], "minimum": 0},
    "provider_cached_tokens": {"type": ["integer", "null"], "minimum": 0},
    "provider_cache_share": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "provider_cache_write_tokens": {"type": ["integer", "null"], "minimum": 0},
    "provider_cache_write_share": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "envmap_version": {"type": "integer", "minimum": 1},
    "envmap_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
