{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aether-next.local/schemas/dynamic_state_delta_v1.schema.json",
  "title": "Aether-Next Dynamic State Delta v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "installed_packages": {"type": "object", "additionalProperties": {"type": ["string", "number"]}},
    "runtime_facts": {"type": "object"},
    "files": {"type": "object"},
    "services": {"type": "object"},
    "jobs": {"type": "object"},
    "artifacts": {"type": "object"},
    "named_sections": {"type": "object"},
    "removed_services": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "removed_jobs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "active_findings": {"type": "array", "items": {"type": "object"}}
  }
}
