{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aether-next.local/schemas/stable_envmap_v1.schema.json",
  "title": "Aether-Next Stable EnvMap v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "version", "sha256", "facts"],
  "properties": {
    "schema_version": {"const": "stable_envmap.v1"},
    "version": {"type": "integer", "minimum": 1},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "facts": {"type": "object"}
  }
}
