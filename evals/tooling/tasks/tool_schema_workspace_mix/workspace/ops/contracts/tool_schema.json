{
  "schema": "workspace_dispatch_contract.v2",
  "snapshot": "data/live_snapshot.ndjson",
  "selection": {
    "candidate_status": "open",
    "candidate_scope": {"file": "config/environments.json", "path": ["environments", "production", "workspace_prefix"]},
    "latest_row_wins_by": "seq",
    "rank": ["priority_ascending", "workspace_id", "ticket_id"]
  },
  "dispatch_required_fields": ["workspace_id", "ticket_id", "action_commands", "source_event_id"],
  "action_templates": ["sync_ticket {ticket_id}", "dispatch_workspace {workspace_id}"]
}
