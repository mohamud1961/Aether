{
  "policy_version": "2.3",
  "default_action": "allow",
  "rules": [
    {
      "id": "deny_protected_writes",
      "tool": "write_file",
      "path_prefix": "protected/",
      "action": "deny"
    }
  ],
  "rewrite_rules": [
    {
      "id": "strip_leading_dot_slash",
      "tool": "write_file",
      "action": "rewrite_path",
      "applies_to": "allowed_calls"
    }
  ]
}
