{
  "schema_version": "worker_packet.v2",
  "packet_version_current": 2,
  "workers": ["ingest", "reconcile", "writer"],
  "keys": ["packet_version", "worker", "goal", "constraint_ids", "inputs", "outputs", "done_when"],
  "types": {
    "packet_version": "integer",
    "worker": "string, one of workers",
    "goal": "non-empty string",
    "constraint_ids": "list of strings, the [C-xx] ids from the thread that apply to this worker",
    "inputs": "list of strings",
    "outputs": "list of strings",
    "done_when": "non-empty string"
  }
}
