  "relevance_note": "Directly explains the mechanism of deferring tool injection using a search primitive to avoid upfront context limits.",
  "reason_included": "Contains highly specific quantitative data on the token cost of static MCP tool definitions vs dynamic retrieval overhead.",
  "claim_snippets": [
    {
      "claim_id": "c1",
      "claim_text": "Static full catalog injection of 50 MCP tools consumes approximately 72K to 77K tokens before task execution, whereas dynamic selection drops this overhead to roughly 8.7K tokens.",
      "claim_status": "measured"
    },
    {
      "claim_id": "c2",
      "claim_text": "Marking tools with `defer_loading: true` allows the model to only see a search primitive and core tools initially; when the search primitive is called, only the 3-5 returned `tool_reference` objects are expanded into full schemas.",
      "claim_status": "asserted"
    }
  ],
