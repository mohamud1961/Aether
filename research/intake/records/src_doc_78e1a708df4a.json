      "claim_id": "c1",
      "claim_text": "The tools/list request supports pagination using an optional cursor parameter.",
      "claim_status": "asserted"
    },
    {
      "claim_id": "c2",
      "claim_text": "Each MCP tool is uniquely identified by name and includes metadata describing its schema.",
      "claim_status": "asserted"
    },
    {
      "claim_id": "c3",
      "claim_text": "Servers SHOULD send notifications/tools/list_changed when the available tool list changes.",
      "claim_status": "asserted"
    },
    {
      "claim_id": "c4",
      "claim_text": "Servers that support dynamic tool updates advertise a tools capability with listChanged set to true.",
      "claim_status": "asserted"
    },
    {
      "claim_id": "c5",
      "claim_text": "Tool annotations are hints only and clients must treat them as untrusted unless they come from a trusted server.",
      "claim_status": "asserted"
    }
