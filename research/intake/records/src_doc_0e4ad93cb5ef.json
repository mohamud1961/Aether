  "claim_snippets": [
    {
      "claim_id": "c1",
      "claim_text": "Custom tools can constrain free-form inputs using context-free grammars expressed in lark or regex formats.",
      "claim_status": "asserted"
    },
    {
      "claim_id": "c2",
      "claim_text": "OpenAI distinguishes function tools defined by JSON Schema from custom tools that accept free-form text inputs and outputs.",
      "claim_status": "asserted"
    },
    {
      "claim_id": "c3",
      "claim_text": "For large function sets or large schemas, the guide recommends pairing function calling with tool search so only relevant tools are provided at runtime.",
      "claim_status": "asserted"
    },
    {
      "claim_id": "c4",
      "claim_text": "Parallel function calling can be disabled with parallel_tool_calls=false; built-in tools do not support parallel calls; strict mode may be disabled for some fine-tuned multi-call settings.",
      "claim_status": "asserted"
    },
    {
      "claim_id": "c5",
      "claim_text": "Complex grammars may be rejected or yield syntactically valid but semantically wrong outputs, and the guide recommends simplifying grammars, reducing overlapping terminals, and tightening tool descriptions.",
      "claim_status": "asserted"
    }
  ],
