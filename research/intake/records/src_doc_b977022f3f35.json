  "relevance_note": "Specifies how Copilot composes multiple instruction sources, including AGENTS.md locality precedence and instruction priority ordering.",
  "reason_included": "Primary-source instruction-layering behaviour for Copilot agents (personal vs repo vs org; nearest AGENTS.md wins).",
  "claim_snippets": [
    {
      "claim_id": "c1",
      "claim_text": "You can store `AGENTS.md` anywhere in the repository; when Copilot is working, the nearest `AGENTS.md` file in the directory tree takes precedence.",
      "claim_status": "asserted"
    },
    {
      "claim_id": "c2",
      "claim_text": "If repository-wide instructions exist and a path-specific instructions file matches a file Copilot is working on, instructions from both files are used.",
      "claim_status": "asserted"
    },
    {
      "claim_id": "c3",
      "claim_text": "Personal instructions have the highest priority, repository instructions come next, and organization instructions are last; all sets of relevant instructions are provided to Copilot.",
      "claim_status": "asserted"
    }
  ],
