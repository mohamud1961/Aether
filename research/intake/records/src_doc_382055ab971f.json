  "claim_snippets": [
    {
      "claim_id": "c1",
      "claim_text": "Action schemas define a small explicit set of allowed actions so an agent must return one valid action instead of improvising intent.",
      "claim_status": "asserted"
    },
    {
      "claim_id": "c2",
      "claim_text": "MCP enforces explicit input and output schemas for every tool and resource and validates calls before execution, preventing bad state from reaching production systems.",
      "claim_status": "asserted"
    },
    {
      "claim_id": "c3",
      "claim_text": "GitHub recommends design for failure first, validate every agent boundary, constrain actions before adding more agents, log intermediate state, and expect retries and partial failures.",
      "claim_status": "asserted"
    }
  ],
