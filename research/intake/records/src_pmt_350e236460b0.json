  "relevance_note": "Concrete operational patterns for preserving recoverability through compaction.",
  "reason_included": "Shows what stays raw versus summarized, and how the agent can recover detail after summary loss. ([Cursor][2])",
  "claim_snippets": [
    {
      "claim_id": "c1",
      "claim_text": "When the context window fills, Cursor triggers summarization to reset the agent into a fresh window, but explicitly notes that knowledge can degrade because the summary is lossy. ([Cursor][2])",
      "claim_status": "asserted"
    },
    {
      "claim_id": "c2",
      "claim_text": "After automatic or manual summarization, Cursor gives the agent a reference to the chat history file so it can search for details missing from the summary and recover them on demand. ([Cursor][2])",
      "claim_status": "asserted"
    },
    {
      "claim_id": "c3",
      "claim_text": "Cursor writes long shell or MCP outputs to files instead of truncating them in-message, then lets the agent inspect them with `tail` and follow-up reads; Cursor says this led to fewer unnecessary summarizations near context limits. ([Cursor][2])",
      "claim_status": "asserted"
    }
  ],
