      "claim_status": "asserted"
    },
    {
      "claim_id": "c3",
      "claim_text": "During execution, read-only tools run in parallel (thread pool) and write tools run sequentially.",
      "claim_status": "asserted"
    },
    {
      "claim_id": "c4",
      "claim_text": "Planning is done by a subagent with read-only tools (no write tools in its schema), eliminating write attempts during planning.",
