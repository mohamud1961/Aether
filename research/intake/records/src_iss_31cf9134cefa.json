  "relevance_note": "LangChain4j issue detailing a durable execution module with checkpoints and journaling",
  "reason_included": "Provides design for durable tasks: checkpoints, journaling, resume after restart",
  "claim_snippets": [
    {
      "claim_id": "c1",
      "claim_text": "ReplayingPlanner: on resume, replays completed invocations from the journal to fast-forward agent state.",
      "claim_status": "asserted"
    },
    {
      "claim_id": "c2",
      "claim_text": "Crash recovery \u2014 if the JVM restarts mid-workflow, the agent should resume from its last checkpoint rather than re-execute from scratch.",
      "claim_status": "asserted"
    },
    {
      "claim_id": "c3",
      "claim_text": "CheckpointPolicy: NONE, AFTER_EACH_AGENT, AFTER_ROOT_CALL \u2014 controls when scope-aware checkpoints are taken at agentic scope boundaries.",
      "claim_status": "asserted"
    },
    {
      "claim_id": "c4",
      "claim_text": "All lifecycle events (agent invocations, retries, pauses, cancellations, completions, failures) are recorded in an ordered, immutable journal per task.",
      "claim_status": "asserted"
    },
    {
      "claim_id": "c5",
      "claim_text": "Store-atomic compare-and-set: all status transitions use TaskExecutionStore.compareAndSetStatus() atomically to prevent a race between cancel and completion.",
      "claim_status": "asserted"
    }
  ],
