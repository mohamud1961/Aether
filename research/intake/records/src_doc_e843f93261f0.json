  "claim_snippets": [
    {
      "claim_id": "c1",
      "claim_text": "A Stop prompt hook can return ok=false with a reason, in which case Claude keeps working and uses the reason as its next instruction.",
      "claim_status": "asserted"
    },
    {
      "claim_id": "c2",
      "claim_text": "Any text the hook command writes to stdout is added to Claude\u2019s context, making reinjection an explicit programmable handoff channel. ([Claude][4])",
      "claim_status": "asserted"
    },
    {
      "claim_id": "c3",
      "claim_text": "Stop hooks fire whenever Claude finishes responding, and if the stop_hook_active field is not checked they can cause an infinite continuation loop.",
      "claim_status": "asserted"
    },
    {
      "claim_id": "c4",
      "claim_text": "An agent-based Stop hook can spawn a subagent with tool access to verify conditions such as whether the test suite passes before allowing Claude to stop.",
      "claim_status": "asserted"
    },
    {
      "claim_id": "c5",
      "claim_text": "Anthropic states that when Claude\u2019s context window fills, compaction summarizes the conversation to free space and can lose important details. ([Claude][4])",
      "claim_status": "asserted"
    }
  ],
