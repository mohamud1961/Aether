  "relevance_note": "Official docs for agent workflow checkpointing",
  "reason_included": "Shows how workflow checkpoints capture full state and how to resume workflows from checkpoints.",
  "claim_snippets": [
    {
      "claim_id": "c1",
      "claim_text": "Workflows can resume from a specific checkpoint on the same run instance or by rehydrating a new run from the checkpoint state.",
      "claim_status": "asserted"
    },
    {
      "claim_id": "c2",
      "claim_text": "Executors must override OnCheckpointingAsync to save their state into the workflow context so it is captured in the checkpoint.",
      "claim_status": "asserted"
    },
    {
      "claim_id": "c3",
      "claim_text": "To enable checkpointing, provide a CheckpointManager or CheckpointStorage when running the workflow; checkpoints can be accessed via run.Checkpoints or SuperStepCompletedEvent.",
      "claim_status": "asserted"
    },
    {
      "claim_id": "c4",
      "claim_text": "Checkpoints capture the entire state of the workflow, including the current state of all executors, all pending messages, requests/responses, and shared states at each superstep.",
      "claim_status": "asserted"
    }
