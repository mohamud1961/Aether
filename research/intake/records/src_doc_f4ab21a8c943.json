  "relevance_note": "Direct comparison of harness choices across Sonnet 4.5 and Opus 4.5.",
  "reason_included": "Shows model-family-specific workflow changes rather than generic agent advice.",
  "claim_snippets": [
    {
      "claim_id": "c1",
      "claim_text": "Before each sprint, the generator and evaluator negotiate a sprint contract specifying what 'done' looks like and how success will be verified before code is written.",
      "claim_status": "asserted"
    },
    {
      "claim_id": "c2",
      "claim_text": "The new system added a planner agent that expands a short user prompt into a full product spec, shifting the harness from requiring a detailed upfront spec to generating one.",
      "claim_status": "asserted"
    },
    {
      "claim_id": "c3",
      "claim_text": "With Opus 4.5, that behavior was largely removed, so the updated harness dropped context resets and ran as one continuous session with automatic compaction handling context growth.",
      "claim_status": "asserted"
    },
    {
      "claim_id": "c4",
      "claim_text": "The harness uses a dedicated evaluator agent with Playwright MCP to click through the running app, test UI features, API endpoints, and database states, then grade each sprint against thresholds.",
      "claim_status": "asserted"
    },
    {
      "claim_id": "c5",
      "claim_text": "The earlier long-running harness used an initializer agent, a coding agent working one feature at a time, and context resets between sessions to keep Sonnet 4.5 on task because of a 'context anxiety' tendency.",
      "claim_status": "asserted"
    }
  ],
