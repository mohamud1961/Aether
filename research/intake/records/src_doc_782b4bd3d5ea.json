  "claim_snippets": [
    {
      "claim_id": "c1",
      "claim_text": "Exported telemetry is tagged with service name, CLI version, environment label, conversation id, model, and sandbox or approval settings.",
      "claim_status": "asserted"
    },
    {
      "claim_id": "c2",
      "claim_text": "With exporter set to none, instrumentation remains active but nothing is sent externally; exporters batch asynchronously and flush on shutdown.",
      "claim_status": "asserted"
    },
    {
      "claim_id": "c3",
      "claim_text": "When enabled, Codex emits structured log events for conversations, API requests, SSE/WebSocket activity, redacted user prompts, tool approval decisions, and tool results.",
      "claim_status": "asserted"
    },
    {
      "claim_id": "c4",
      "claim_text": "Codex telemetry is opt-in and off by default to keep local runs self-contained.",
      "claim_status": "asserted"
    }
  ],
