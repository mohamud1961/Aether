  "relevance_note": "Official mechanism spec for implicit and explicit caching, TTL, and usage accounting.",
  "reason_included": "Directly covers cache policy, billing drivers, and returned usage fields.",
  "claim_snippets": [
    {
      "claim_id": "c1",
      "claim_text": "The API returns cached-token information in usage_metadata so clients can measure reuse directly.",
      "claim_status": "asserted"
    },
    {
      "claim_id": "c2",
      "claim_text": "Explicit caches use a time-to-live, defaulting to one hour, and the cost depends on the size of the cached input and how long it is stored.",
      "claim_status": "asserted"
    },
    {
      "claim_id": "c3",
      "claim_text": "Minimum token counts for caching vary by model, cached content must be a prefix, and cached tokens still count against the model's token limits and standard rate limits.",
      "claim_status": "asserted"
    },
    {
      "claim_id": "c4",
      "claim_text": "Implicit caching is enabled automatically for Gemini 2.5 models, while explicit caching provides guaranteed savings when a reusable prefix should persist across requests.",
      "claim_status": "asserted"
    },
    {
      "claim_id": "c5",
      "claim_text": "Billing for explicit caching combines reduced-rate cached-token usage with cache-storage duration charges plus the usual charges for other input, output, and tool-use tokens.",
      "claim_status": "asserted"
    }
  ],
