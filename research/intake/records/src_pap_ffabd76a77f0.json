      "claim_id": "c2",
      "claim_text": "SWE-bench evaluates LLMs on their ability to resolve real GitHub issues from popular open-source repositories by generating a functional patch.",
      "claim_status": "asserted"
    },
    {
      "claim_id": "c3",
      "claim_text": "The Agent-Computer Interface (ACI) must provide specialized navigation commands like 'search_dir' and 'search_file' to allow the agent to incrementally localize problems without loading full files into context.",
      "claim_status": "asserted"
    },
    {
      "claim_id": "c4",
      "claim_text": "Failures in problem localization often stem from the agent skipping 'find' steps and jumping directly to 'open_file' based on broad keyword guesses.",
