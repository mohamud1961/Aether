  "relevance_note": "Real long-running parallel coding harness with concrete coordination primitives and failure reports.",
  "reason_included": "Exposes a non-orchestrated parallel topology, synchronization scheme, and where parallelism breaks.",
  "claim_snippets": [
    {
      "claim_id": "c1",
      "claim_text": "The harness runs Claude in an infinite autonomous loop, then scales out to multiple agents by placing each in its own Docker container with a local clone of a shared bare git repository.",
      "claim_status": "asserted"
    },
    {
      "claim_id": "c2",
      "claim_text": "Coordination is implemented with lock files in current_tasks plus pull-merge-push cycles; the prototype intentionally has no orchestration agent and frequent merge conflicts are part of normal operation.",
      "claim_status": "asserted"
    },
    {
      "claim_id": "c3",
      "claim_text": "Parallelism helped when many failures were independent, but 16 agents stalled on Linux-kernel compilation because they all hit the same bottleneck; using GCC as a known-good oracle re-partitioned work and restored useful parallelism.",
      "claim_status": "anecdotal"
    }
  ],
  "claim_locations": [
    {
      "claim_id": "c1",
      "locator": "Sections 'Enabling long-running Claudes' and 'Running Claude in parallel', lines 24-29 and 49-54 on Anthropic page"
