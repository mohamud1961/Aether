  "claim_snippets": [
    {
      "claim_id": "c1",
      "claim_text": "Dynamic tools are persisted on thread metadata and restored on resume.",
      "claim_status": "asserted"
    },
    {
      "claim_id": "c2",
      "claim_text": "If an enabled required MCP server fails to initialize, thread start and resume fail instead of continuing without it.",
      "claim_status": "asserted"
    },
    {
      "claim_id": "c3",
      "claim_text": "skills/list may return a cached result, and forceReload:true refreshes it; if a skill item is omitted, the model may still try to locate it, adding latency.",
      "claim_status": "asserted"
    },
    {
      "claim_id": "c4",
      "claim_text": "The app server exposes plugin/list, app/list, mcpServer/oauth/login, config/mcpServer/reload, and mcpServerStatus/list methods; mcpServerStatus/list includes MCP servers, tools, resources, and auth status.",
      "claim_status": "asserted"
    }
  ],
