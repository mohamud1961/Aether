  "claim_snippets": [
    {
      "claim_id": "c1",
      "claim_text": "Removing the Adaptive Refiner causes a 23.2 percentage point drop in reproduction success rate on SecBench.js and leads to repeated ineffective debugging loops.",
      "claim_status": "measured"
    },
    {
      "claim_id": "c2",
      "claim_text": "The framework argues that naive experience injection inflates context, so it indexes prior attempts by failure characteristics for sparse retrieval relevant to the current failure.",
      "claim_status": "asserted"
    },
    {
      "claim_id": "c3",
      "claim_text": "Cve2PoC uses a dual-loop design: the Strategic Planner makes structured attack plans, the Tactical Executor performs code generation with progressive verification, and the Adaptive Refiner routes failures either to tactical refinement or strategic replanning.",
      "claim_status": "asserted"
    }
  ],
