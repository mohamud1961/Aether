  "claim_snippets": [
    {
      "claim_id": "c1",
      "claim_text": "Captured API traffic shows different filenames across successive calls and about 16.8K cache_creation_input_tokens with zero cache_read_input_tokens on the follow-up request.",
      "claim_status": "measured"
    },
    {
      "claim_id": "c2",
      "claim_text": "A practical workaround is to normalize the UUID-bearing filename to a fixed all-zero filename before the request reaches the provider API.",
      "claim_status": "asserted"
    },
    {
      "claim_id": "c3",
      "claim_text": "The reported root cause is a per-call temporary settings filename created with crypto.randomUUID() and embedded into the Bash tool's denyWithinAllow description.",
      "claim_status": "asserted"
    },
    {
      "claim_id": "c4",
      "claim_text": "A random UUID inserted into the Bash tool description invalidates an otherwise reusable 17K-token cached prefix and causes each follow-up call to pay full cache-write pricing instead of cache-read pricing.",
      "claim_status": "asserted"
    }
  ],
