  "relevance_note": "Explicit topology guidance based on task coupling for long-running scientific coding.",
  "reason_included": "Provides concrete selection rule for parallel team versus sequential agent plus subagents.",
  "claim_snippets": [
    {
      "claim_id": "c1",
      "claim_text": "A Ralph-loop style orchestration pattern is used to push the agent past premature completion by re-entering context until the explicit success criterion is met.",
      "claim_status": "asserted"
    },
    {
      "claim_id": "c2",
      "claim_text": "CLAUDE.md serves as a mutable global plan kept in context, while CHANGELOG.md serves as portable long-term memory so later sessions avoid retrying failed approaches.",
      "claim_status": "asserted"
    },
    {
      "claim_id": "c3",
      "claim_text": "A Boltzmann solver is treated as a deeply coupled pipeline where a single agent working sequentially, spawning subagents as needed, is better suited than a large parallel team.",
      "claim_status": "asserted"
    }
  ],
