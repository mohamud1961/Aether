  "relevance_note": "Official config surface for category-level approval routing and sandbox hardening.",
  "reason_included": "Includes concrete fail-closed approval categories, hardening toggles, and sandbox-escape notes.",
  "claim_snippets": [
    {
      "claim_id": "c1",
      "claim_text": "allow_login_shell = false is an optional hardening control that disallows login shells for shell tools.",
      "claim_status": "asserted"
    },
    {
      "claim_id": "c2",
      "claim_text": "Workspace-write mode can be bounded with writable_roots and network_access, where outbound network remains opt-in.",
      "claim_status": "asserted"
    },
    {
      "claim_id": "c3",
      "claim_text": "Codex supports a granular approval policy that can independently gate sandbox approvals, execpolicy-rule prompts, MCP elicitations, request_permissions prompts, and skill_approval prompts.",
      "claim_status": "asserted"
    },
    {
      "claim_id": "c4",
      "claim_text": "Some environments keep .git and .codex read-only even when the rest of the workspace is writable, so commands like git commit may still require approval to run outside the sandbox; rules can be used to block specific commands.",
      "claim_status": "asserted"
    }
  ],
