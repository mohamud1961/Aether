  "relevance_note": "Gives explicit next-action and stop rules for Codex-style coding loops.",
  "reason_included": "Contains operational constraints on planning, loop termination, and state handoff via phase.",
  "claim_snippets": [
    {
      "claim_id": "c1",
      "claim_text": "The guide treats codebase exploration as one of the most critical prompt snippets to preserve when migrating a harness to codex-cli.",
      "claim_status": "asserted"
    },
    {
      "claim_id": "c2",
      "claim_text": "Before finishing, Codex should reconcile every prior plan or TODO item and mark it Done, Blocked, or Cancelled, with no pending items left open.",
      "claim_status": "asserted"
    },
    {
      "claim_id": "c3",
      "claim_text": "When using the planning tool, Codex should skip it for straightforward tasks, avoid single-step plans, update plans after subtask progress, and never end with only a plan.",
      "claim_status": "asserted"
    },
    {
      "claim_id": "c4",
      "claim_text": "The recommended prompt tells the agent to prefer `rg`/`rg --files`, choose dedicated read/search tools over raw shell when available, and parallelize file searches and reads.",
      "claim_status": "asserted"
    },
    {
      "claim_id": "c5",
      "claim_text": "If the agent is re-reading or re-editing the same files without clear progress, it should stop that loop and end the turn with a concise summary and any needed clarifying questions.",
      "claim_status": "asserted"
    }
  ],
