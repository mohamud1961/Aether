  "relevance_note": "Specifies how agents should discover, scope, and progressively load file-local guidance.",
  "reason_included": "Directly relevant to narrowing guidance to the current file region without polluting context.",
  "claim_snippets": [
    {
      "claim_id": "c1",
      "claim_text": "The proposal adds optional frontmatter (`description`, `tags`) so harnesses can index available AGENTS.md files and decide when to load full contents without up-front full-file loads.",
      "claim_status": "asserted"
    },
    {
      "claim_id": "c2",
      "claim_text": "AGENTS.md guidance is ancestor-scoped: only files in the target file's directory or parent directories apply, guidance accumulates down the tree, and more specific files override ancestors.",
      "claim_status": "asserted"
    },
    {
      "claim_id": "c3",
      "claim_text": "The recommended progressive-disclosure flow is: scan AGENTS.md paths at session start, inject a lightweight index, then load files on demand; during compaction, preserve behavior-affecting guidance first.",
      "claim_status": "asserted"
    }
  ],
