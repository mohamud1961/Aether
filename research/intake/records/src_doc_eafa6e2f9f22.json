      "claim_status": "measured"
    },
    {
      "claim_id": "c3",
      "claim_text": "MCP tool libraries can consume very large prompt prefixes, with the writeup citing about 72K tokens for 50+ tools and about 134K tokens in Anthropic's internal setup.",
      "claim_status": "measured"
    },
    {
      "claim_id": "c4",
      "claim_text": "A Tool Search Tool can reduce initial tool-related context from about 77K tokens to about 8.7K tokens, an 85% reduction, by loading relevant tools on demand instead of up front.",
      "claim_status": "measured"
    },
    {
      "claim_id": "c5",
      "claim_text": "Tool Search Tool defers most tool definitions and expands only matched tools into context, reducing initial tool overhead from ~77K tokens to ~8.7K tokens in the example and preserving 95% of the context window.",
      "claim_status": "measured"
    }
