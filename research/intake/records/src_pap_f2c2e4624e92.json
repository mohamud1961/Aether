  "claim_snippets": [
    {
      "claim_id": "c1",
      "claim_text": "The benchmark isolates three dominant failure modes: Premature Submission (37.2%), Consensus Failure (29.9%), and Computation Error (28.6%), which together define a communication-reasoning gap.",
      "claim_status": "measured"
    },
    {
      "claim_id": "c2",
      "claim_text": "At larger scales, spontaneous leader emergence can hurt outcomes: on Level-III tasks runs with an emergent leader have 0.0% success versus 33.3% without one, indicating centralization bottlenecks.",
      "claim_status": "measured"
    },
    {
      "claim_id": "c3",
      "claim_text": "Silo-Bench evaluates multi-agent coordination across three orthogonal axes\u2014agent scale, communication protocol, and model\u2014under parallel round-based execution.",
