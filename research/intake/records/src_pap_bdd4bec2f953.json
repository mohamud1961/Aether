  "claim_snippets": [
    {
      "claim_id": "c1",
      "claim_text": "Fixed-horizon baselines waste tokens and latency: on HumanEval, DyTopo reaches the highest accuracy while using 48% of AgentScope\u2019s tokens and converging in 2.6 rounds on average.",
      "claim_status": "measured"
    },
    {
      "claim_id": "c2",
      "claim_text": "Across code-generation and mathematical-reasoning benchmarks with four LLM backbones, DyTopo beats the strongest baseline in all 16 backbone-dataset settings with mean gain about 6.1 points.",
      "claim_status": "measured"
    },
    {
      "claim_id": "c3",
      "claim_text": "DyTopo reconstructs a sparse directed communication graph every round by semantically matching each agent\u2019s query descriptor to other agents\u2019 key descriptors, then routes only the induced private messages.",
      "claim_status": "asserted"
    }
  ],
