  "claim_snippets": [
    {
      "claim_id": "c1",
      "claim_text": "Because grading errors were identified in tau-bench, the authors restrict analysis to 26 clean tasks and show that predictability and safety improve on the cleaned subset.",
      "claim_status": "measured"
    },
    {
      "claim_id": "c2",
      "claim_text": "The study replaces single-score evaluation with twelve reliability metrics spanning consistency, robustness, predictability, and safety.",
      "claim_status": "asserted"
    },
    {
      "claim_id": "c3",
      "claim_text": "For reproducibility, the study uses deterministic generation settings, logged API calls via Weave, cached prompt perturbations, retries, and explicit timeout policies.",
