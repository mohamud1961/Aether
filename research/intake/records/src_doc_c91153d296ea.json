  "relevance_note": "Effective harnesses for long-running agents is a engineering writeup source with details on model x context, initializer agent relevant to context engineering.",
  "reason_included": "Included for source-local evidence on context, artifacts workspace, execution loop.",
  "claim_snippets": [
    {
      "claim_id": "c1",
      "claim_text": "Compaction alone was not sufficient: Opus 4.5 on Claude Agent SDK, looped across context windows with only a high-level prompt, fell short of building a production-quality web app.",
      "claim_status": "asserted"
    },
    {
      "claim_id": "c2",
      "claim_text": "The harness uses a two-role topology: an initializer agent creates the initial environment, while a coding agent repeatedly resumes work in later sessions using the artifacts left behind.",
      "claim_status": "asserted"
    },
    {
      "claim_id": "c3",
      "claim_text": "A dominant failure pattern was attempting too much at once, exhausting context mid-implementation and forcing the next session to guess what happened from a half-implemented undocumented state.",
      "claim_status": "asserted"
    },
    {
      "claim_id": "c4",
      "claim_text": "Anthropic's two-fold solution for long-running work uses an initializer agent on the first run and a coding agent that makes incremental progress while leaving clear artifacts for the next session.",
      "claim_status": "asserted"
    },
    {
      "claim_id": "c5",
      "claim_text": "The initializer writes init.sh, a progress file, and an initial git commit; later coding sessions read progress notes, git history, and a structured feature list before choosing a single next feature.",
      "claim_status": "asserted"
    }
  ],
