  "claim_snippets": [
    {
      "claim_id": "c1",
      "claim_text": "Terminal-Bench 2.0 runs each supported agent-model configuration at least five times, yielding 32,155 total trials.",
      "claim_status": "measured"
    },
    {
      "claim_id": "c2",
      "claim_text": "Average episode count has negligible correlation with success rate, indicating that simply taking more interaction rounds does not predict solving the task.",
      "claim_status": "measured"
    },
    {
      "claim_id": "c3",
      "claim_text": "Terminal-Bench 2.0 contains 89 terminal tasks, each with a unique environment, a human-written solution, and comprehensive tests for verification; frontier systems solve less than 65% of tasks.",
      "claim_status": "measured"
    },
    {
      "claim_id": "c4",
      "claim_text": "A task is well-specified only if its unit tests pass if and only if the container ends in an acceptable state.",
      "claim_status": "asserted"
    },
    {
      "claim_id": "c5",
      "claim_text": "Each task includes an oracle solution script; automated review runs the oracle to ensure the task is solvable before acceptance.",
      "claim_status": "asserted"
    }
  ],
