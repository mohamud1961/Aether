  "claim_snippets": [
    {
      "claim_id": "c1",
      "claim_text": "On the Agent-Sentry benchmark, the system prevents over 90% of attacks while preserving up to 95% of utility, and on AgentDojo it prevents over 96% of attacks while preserving up to 98% of utility.",
      "claim_status": "measured"
    },
    {
      "claim_id": "c2",
      "claim_text": "Agent-Sentry constructs behavioral bounds from frequent execution traces and blocks tool calls that deviate from learned behaviors or misalign with user intent.",
      "claim_status": "asserted"
    },
    {
      "claim_id": "c3",
      "claim_text": "The paper identifies mimicry attacks as a residual failure mode where adversarial traces can resemble benign executions closely enough to require ambiguity handling rather than outright blocking.",
      "claim_status": "asserted"
    }
  ],
