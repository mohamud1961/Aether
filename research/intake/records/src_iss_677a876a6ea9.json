  "claim_snippets": [
    {
      "claim_id": "c1",
      "claim_text": "Setting `\"useRipgrep\": false` in settings bypasses ripgrep initialization and immediately removes the startup delay.",
      "claim_status": "anecdotal"
    },
    {
      "claim_id": "c2",
      "claim_text": "Installing ripgrep system-wide at `/usr/bin/rg` does not help because the CLI looks only in its internal bin directory.",
      "claim_status": "anecdotal"
    },
    {
      "claim_id": "c3",
      "claim_text": "The issue reports multi-minute startup stalls because the CLI tries to download ripgrep to `~/.gemini/bin/rg` during initialization.",
      "claim_status": "anecdotal"
    }
  ],
