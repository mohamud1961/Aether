  "relevance_note": "AAMF migration framework's checkpoint and resume design",
  "reason_included": "Shows that all execution state is saved to files and how resume works after interruption.",
  "claim_snippets": [
    {
      "claim_id": "c1",
      "claim_text": "Failed agent tasks are retried up to a max (default 3); infrastructure errors (file-lock, OOM, network) are retried separately.",
      "claim_status": "asserted"
    },
    {
      "claim_id": "c2",
      "claim_text": "All execution state is persisted to `.aamf/migration/.../state/checkpoint.json` after every phase or task completion; the checkpoint records phase cursors, completed/failed tasks, outputs, token usage, etc.",
      "claim_status": "asserted"
    },
    {
      "claim_id": "c3",
      "claim_text": "To resume an interrupted migration, use `--resume`; the orchestrator skips completed phases and resumes from saved cursors. A backup checkpoint (state/checkpoint.backup.json) is kept for corruption recovery.",
      "claim_status": "asserted"
    }
  ],
