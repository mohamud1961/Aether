  "relevance_note": "Official permission model for allow, ask, and deny rules.",
  "reason_included": "Defines rule semantics and precedence used by approval gates.",
  "claim_snippets": [
    {
      "claim_id": "c1",
      "claim_text": "The /permissions UI shows all tool permission rules and the settings.json file each rule came from.",
      "claim_status": "asserted"
    },
    {
      "claim_id": "c2",
      "claim_text": "Rules are evaluated in order deny -> ask -> allow, and the first matching rule wins, so deny rules take precedence.",
      "claim_status": "asserted"
    },
    {
      "claim_id": "c3",
      "claim_text": "Claude Code exposes permission modes that control how tools are approved, with defaultMode configurable in settings files.",
      "claim_status": "asserted"
    },
    {
      "claim_id": "c4",
      "claim_text": "Allow rules let Claude Code use the specified tool without manual approval, ask rules prompt for confirmation, and deny rules prevent tool use.",
      "claim_status": "asserted"
    }
  ],
