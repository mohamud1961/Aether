  "relevance_note": "Direct tool-calling methodology paper on independent decoding of tool names and arguments.",
  "reason_included": "Covers latency, parallel decoding, and how to handle parallel-call benchmarks.",
  "claim_snippets": [
    {
      "claim_id": "c1",
      "claim_text": "With quantization, a Qwen3-4B model reaches 61.2 ms P50 latency and 16 Hz control on consumer hardware.",
      "claim_status": "measured"
    },
    {
      "claim_id": "c2",
      "claim_text": "It reports 3x to 6x end-to-end speedups, up to 9.6x, with only 8.2% overhead from the parallelization machinery.",
      "claim_status": "measured"
    },
    {
      "claim_id": "c3",
      "claim_text": "SimpleTool introduces special tokens that compress low-entropy function-call tokens by about 4x to 6x and act as mode selectors for independent decoding of function name and arguments.",
      "claim_status": "asserted"
    },
    {
      "claim_id": "c4",
      "claim_text": "For benchmarks with parallel tool invocations, the method decomposes them into sequential single-step samples using history-based decomposition and random shuffling of prefix calls to teach order independence.",
      "claim_status": "asserted"
    }
  ],
