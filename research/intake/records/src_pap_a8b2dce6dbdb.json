  "relevance_note": "Introduces browser-task oracles that track pre and post conditions instead of treating navigation as success.",
  "reason_included": "Direct source on external oracles and false-completion failure modes in web E2E agents.",
  "claim_snippets": [
    {
      "claim_id": "c1",
      "claim_text": "On the benchmark of bug-injected web apps, WebTestPilot reports 99% task completion with 96% precision and 96% recall in bug detection.",
      "claim_status": "measured"
    },
    {
      "claim_id": "c2",
      "claim_text": "Prior LLM web-testing approaches can miss bugs by either treating any non-crashing navigation as success or checking states in isolation without prior-step context.",
      "claim_status": "asserted"
    },
    {
      "claim_id": "c3",
      "claim_text": "WebTestPilot converts natural-language requirements into step sequences with inferred pre- and post-conditions over symbolized GUI elements, using them as an oracle.",
      "claim_status": "asserted"
    }
  ],
