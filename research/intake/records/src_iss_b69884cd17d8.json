  "relevance_note": "Auto-compaction triggers prematurely due to cache tokens counted as context usage is a issue thread source with details on token accounting, compaction thresholding relevant to cost token management.",
  "reason_included": "Included for source-local evidence on cost budget, context, recovery.",
  "claim_snippets": [
    {
      "claim_id": "c1",
      "claim_text": "The report states that 13 of 14 auto-compactions were false alarms, with one example showing 174K computed tokens versus about 118K actual context tokens.",
      "claim_status": "measured"
    },
    {
      "claim_id": "c2",
      "claim_text": "Sessions that previously ran for seven or more hours reportedly began compacting every 11 to 33 minutes after large tool results once the accounting regression was introduced.",
      "claim_status": "measured"
    },
    {
      "claim_id": "c3",
      "claim_text": "The session token accounting function included cacheRead and cacheWrite tokens in totalTokens, inflating context usage and causing premature auto-compaction triggers.",
      "claim_status": "asserted"
    },
    {
      "claim_id": "c4",
      "claim_text": "The proposed fix is to exclude cacheRead and cacheWrite from context usage calculations and to refresh totalTokens immediately after compaction so thresholds use post-compaction state.",
      "claim_status": "asserted"
    }
  ],
