  "relevance_note": "Current provider doc with explicit multi-call, mode, and parser-handling semantics.",
  "reason_included": "Directly affects harness parsing, state threading, and response ordering.",
  "claim_snippets": [
    {
      "claim_id": "c1",
      "claim_text": "Parallel function calling supports multiple independent calls, and tool responses must be sent back in the same order requested.",
      "claim_status": "asserted"
    },
    {
      "claim_id": "c2",
      "claim_text": "Gemini 3 generates a unique id for every function call; manual histories and REST callers should return the matching id in functionResponse.",
      "claim_status": "asserted"
    },
    {
      "claim_id": "c3",
      "claim_text": "The Python SDK can automatically execute functions by converting Python callables to declarations, detecting function calls, running them, and sending the responses back.",
      "claim_status": "asserted"
    },
    {
      "claim_id": "c4",
      "claim_text": "Function calling modes include AUTO, ANY, NONE, and VALIDATED; ANY forces function calls and guarantees schema adherence, while VALIDATED permits either natural language or function calls with schema adherence.",
      "claim_status": "asserted"
    },
    {
      "claim_id": "c5",
      "claim_text": "When combining built-in tools and function calling, functionCall, toolCall, and toolResponse parts may coexist in one turn, so callers should iterate all parts rather than assume functionCall is in a fixed position.",
      "claim_status": "asserted"
    }
  ],
