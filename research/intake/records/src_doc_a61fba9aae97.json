      "claim_id": "c1",
      "claim_text": "When sending long context, the recommended placement is to put the actual query or question at the end of the prompt.",
      "claim_status": "asserted"
    },
    {
      "claim_id": "c2",
      "claim_text": "Longer prompts increase time-to-first-token, so unnecessary tokens should be omitted even when the model can technically fit them.",
      "claim_status": "asserted"
    },
    {
      "claim_id": "c3",
      "claim_text": "The guide frames a cost-accuracy tradeoff in which high retrieval accuracy over many pieces of evidence can require many repeated requests, making cache reuse materially important.",
      "claim_status": "asserted"
    },
    {
      "claim_id": "c4",
      "claim_text": "For long-context workloads, context caching is the main optimization because repeated queries against the same large context otherwise pay the full repeated input cost on every request.",
      "claim_status": "asserted"
    }
  ],
