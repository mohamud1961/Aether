  "claim_snippets": [
    {
      "claim_id": "c1",
      "claim_text": "Codex is instructed to run verification after every milestone and repair failures before continuing.",
      "claim_status": "asserted"
    },
    {
      "claim_id": "c2",
      "claim_text": "Plan.md attaches acceptance criteria and validation commands to each milestone and includes a stop-and-fix rule if validation fails.",
      "claim_status": "asserted"
    },
    {
      "claim_id": "c3",
      "claim_text": "The prompt spec file freezes goals, deliverables, and a 'done when' section so the agent does not build something impressive but wrong.",
      "claim_status": "asserted"
    },
    {
      "claim_id": "c4",
      "claim_text": "Prompt.md is used to freeze goals, non-goals, hard constraints, deliverables, and a 'done when' section so the agent does not drift toward an impressive but wrong target.",
      "claim_status": "asserted"
    },
    {
      "claim_id": "c5",
      "claim_text": "The plan file encoded milestone-sized checkpoints, acceptance criteria, validation commands, and a stop-and-fix rule that required repair before moving on if validation failed.",
      "claim_status": "asserted"
    }
  ],
