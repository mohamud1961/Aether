  "relevance_note": "Server/API-level compaction mechanism with explicit trigger configuration, compaction blocks, and continuation semantics.",
  "reason_included": "Primary vendor doc with concrete compaction trigger, pause, and continuation rules for long-running tool-using workloads.",
  "claim_snippets": [
    {
      "claim_id": "c1",
      "claim_text": "When streaming with compaction enabled, the compaction block streams as a single delta containing the complete summary content (no intermediate streaming).",
      "claim_status": "asserted"
    },
    {
      "claim_id": "c2",
      "claim_text": "`pause_after_compaction` pauses the API after generating the compaction summary and returns a message with stop reason `compaction`, allowing the client to append additional content blocks before continuing.",
      "claim_status": "asserted"
    },
    {
      "claim_id": "c3",
      "claim_text": "When compaction is enabled, the API \"detects\" that input tokens exceed a trigger threshold, \"generates a summary\", creates a `compaction` block containing the summary, and continues the response with compacted context.",
      "claim_status": "asserted"
    },
    {
      "claim_id": "c4",
      "claim_text": "On subsequent requests, the API \"automatically drops all message blocks prior to the `compaction` block\", continuing the conversation from the summary; when a request contains a compaction block, \"all content blocks before it are ignored\".",
      "claim_status": "asserted"
    }
  ],
