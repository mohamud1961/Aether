  "claim_snippets": [
    {
      "claim_id": "c1",
      "claim_text": "In Anthropic\u2019s internal research eval, a multi-agent system with Claude Opus 4 lead and Claude Sonnet 4 subagents outperformed single-agent Claude Opus 4 by 90.2%, with token usage explaining most variance on BrowseComp.",
      "claim_status": "measured"
    },
    {
      "claim_id": "c2",
      "claim_text": "Detailed delegation prompts and explicit scaling rules were required to prevent duplicated work and runaway subagent counts; parallelizing both subagents and tool calls cut research time by up to 90%, while synchronous lead-agent execution still created bottlenecks.",
      "claim_status": "measured"
    },
    {
      "claim_id": "c3",
      "claim_text": "The production research system uses an orchestrator-worker topology: a lead agent plans, persists its plan to memory, spawns specialized subagents in parallel, and hands final findings to a CitationAgent.",
      "claim_status": "asserted"
    }
  ],
