      "claim_text": "Subagent spawning can be allowlisted so only specific agent types can be created, and attempts to spawn other types fail.",
      "claim_status": "asserted"
    },
    {
      "claim_id": "c2",
      "claim_text": "Chained subagents support sequential multi-step workflows where each subagent returns results and Claude passes relevant context to the next worker.",
      "claim_status": "asserted"
    },
    {
      "claim_id": "c3",
      "claim_text": "Automatic delegation is driven by the task description, the subagent description field, and current context; stronger descriptions encourage proactive delegation.",
      "claim_status": "asserted"
    },
    {
      "claim_id": "c4",
      "claim_text": "Each subagent runs in its own context window with a custom system prompt, specific tool access, and independent permissions, and Claude delegates when the task matches the subagent description.",
      "claim_status": "asserted"
    }
