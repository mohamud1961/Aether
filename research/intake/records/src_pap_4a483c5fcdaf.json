  "claim_snippets": [
    {
      "claim_id": "c1",
      "claim_text": "Hybrid-Gym explicitly includes function localization and issue localization tasks so agents must search the repository, reason over descriptions or issues, and make file edits without relying on full executable setup.",
      "claim_status": "measured"
    },
    {
      "claim_id": "c2",
      "claim_text": "The function-localization task requires effective targeted search over the whole repository, while issue localization requires analyzing the issue, exploring the repository, planning the fix, and making successful file-editing actions.",
      "claim_status": "measured"
    },
    {
      "claim_id": "c3",
      "claim_text": "The dependency-search task forces agents to resolve each referenced name to the correct in-repo definition across files, which is non-trivial because multiple modules may share the same name; evaluation checks that all and only the correct dependency definitions are annotated.",
      "claim_status": "measured"
    }
  ],
