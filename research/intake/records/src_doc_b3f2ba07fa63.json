  "relevance_note": "Official launch note tying runtime tool search to token, cache, and latency tradeoffs.",
  "reason_included": "Concrete provider statement about deferring large tool surfaces until runtime.",
  "claim_snippets": [
    {
      "claim_id": "c1",
      "claim_text": "Tool search in the Responses API lets models defer large tool surfaces until runtime.",
      "claim_status": "asserted"
    },
    {
      "claim_id": "c2",
      "claim_text": "The same release introduced native Compaction support for longer-running agent workflows.",
      "claim_status": "asserted"
    },
    {
      "claim_id": "c3",
      "claim_text": "OpenAI states that this reduces token usage, preserves cache performance, and improves latency.",
      "claim_status": "asserted"
    },
    {
      "claim_id": "c4",
      "claim_text": "OpenAI introduced the `minimal` reasoning-effort value for GPT-5 models to optimize for faster responses.",
      "claim_status": "asserted"
    },
    {
      "claim_id": "c5",
      "claim_text": "OpenAI introduced a `custom` tool-call type that allows freeform inputs to and outputs from the model when tool calling.",
      "claim_status": "asserted"
    }
  ],
