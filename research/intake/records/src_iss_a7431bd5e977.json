  "claim_snippets": [
    {
      "claim_id": "c1",
      "claim_text": "The issue reports that Codex added a configurable `tool_output_token_limit`, but non-codex GPT-5.1 prompts still hard-code a 250-line / 10-kilobyte shell-reading rule.",
      "claim_status": "asserted"
    },
    {
      "claim_id": "c2",
      "claim_text": "The reported consequence is too many tool calls, model confusion, longer task execution, and lower-quality outputs.",
      "claim_status": "anecdotal"
    },
    {
      "claim_id": "c3",
      "claim_text": "With `tool_output_token_limit = 25000`, the model still behaves as if output is capped at roughly 256 lines / 10 KB, insists on 250-line chunking, and treats full-file reads as truncated.",
      "claim_status": "anecdotal"
    }
  ],
