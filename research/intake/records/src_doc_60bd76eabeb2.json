  "relevance_note": "Repository rules and skill metadata are used to force verification and route workflow steps.",
  "reason_included": "Shows concrete if-then workflow control embedded in repo instructions and skill descriptions.",
  "claim_snippets": [
    {
      "claim_id": "c1",
      "claim_text": "The code-change-verification rule is conditional, but once triggered it requires formatting, lint, type-checking, and tests, and the work is not complete until that stack passes.",
      "claim_status": "asserted"
    },
    {
      "claim_id": "c2",
      "claim_text": "Skills follow a progressive-disclosure model where name and description are loaded first; in practice description becomes a main routing signal before Codex reads the rest of the skill.",
      "claim_status": "asserted"
    },
    {
      "claim_id": "c3",
      "claim_text": "The repo uses short if/then rules in AGENTS.md so that before runtime or API edits Codex must call implementation-strategy, and if code, tests, examples, or build behavior change it must call code-change-verification.",
      "claim_status": "asserted"
    }
  ],
