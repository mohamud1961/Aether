  "relevance_note": "Prompt Caching 201 is a official doc source with details on exact prefix match, min cacheable prefix tokens 1024 relevant to context engineering.",
  "reason_included": "Included for source-local evidence on context, cost budget, observability.",
  "claim_snippets": [
    {
      "claim_id": "c1",
      "claim_text": "In an experiment described by the author (2300 prompts), cached requests were reported ~7% faster at 1024 tokens and ~67% faster TTFT at 150k+ tokens.",
      "claim_status": "measured"
    },
    {
      "claim_id": "c2",
      "claim_text": "In a 10,000-request comparison, Flex processing with extended prompt caching and prompt_cache_key achieved an 8.5% higher cache-hit rate and about 23% lower input-token cost than Batch.",
      "claim_status": "measured"
    },
    {
      "claim_id": "c3",
      "claim_text": "The guide recommends monitoring cached_tokens per request plus usage logs and notes that compaction or dropping earlier turns can reduce cache reuse even when semantics stay similar.",
      "claim_status": "asserted"
    },
    {
      "claim_id": "c4",
      "claim_text": "The writeup states prompt caching applies to the key/value projections in transformer attention layers, letting inference reuse prior prefill work instead of recomputing it from scratch.",
      "claim_status": "asserted"
    },
    {
      "claim_id": "c5",
      "claim_text": "To maximize cache hits, keep static content and tool definitions at the front and volatile content at the end; using allowed_tools prevents changing tool schemas from invalidating the cached prefix.",
      "claim_status": "asserted"
    }
  ],
