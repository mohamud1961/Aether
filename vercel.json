{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "website/public",
  "rewrites": [
    {
      "source": "/",
      "destination": "/funding-cards.html"
    },
    {
      "source": "/funding-cards",
      "destination": "/funding-cards.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
